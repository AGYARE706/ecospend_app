# PostgreSQL
POSTGRES_DB=ecospend
POSTGRES_USER=ecospend
POSTGRES_PASSWORD=ecospend_dev
POSTGRES_PORT=5432

# JWT — generate secret with: openssl rand -base64 64
# Must be identical on identity-service and api-gateway (Base64-encoded).
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_64
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Service ports
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
EXPENSE_SERVICE_PORT=8082
VAULT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# Paystack (payment-service)
# Leave PAYSTACK_SECRET_KEY blank to run in SIMULATED mode: wallet top-ups
# verify instantly and MoMo transfers auto-succeed — no Paystack account
# needed for demos. Set a sk_test_... key to exercise the real test API.
PAYSTACK_SECRET_KEY=
# Where Paystack redirects the browser after checkout (deep link into the app).
PAYSTACK_CALLBACK_URL=ecospend://payments/callback

# Notification service (Expo Push) — only needed if the Expo project has
# "Enhanced Security for Push Notifications" enabled; blank otherwise.
EXPO_ACCESS_TOKEN=

# Mobile app — single entry point through gateway
# Android emulator: http://10.0.2.2:8080
API_BASE_URL=http://localhost:8080

# Dev notes
# - Auth uses phone + password (min 8 chars), not PIN.
# - Password-reset OTP is logged to identity-service stdout (for local/dev).
