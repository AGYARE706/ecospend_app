# PostgreSQL
POSTGRES_DB=ecospend
POSTGRES_USER=ecospend
POSTGRES_PASSWORD=ecospend_dev
POSTGRES_PORT=5432

# JWT — generate secret with: openssl rand -base64 64
# Must be identical on identity-service and api-gateway
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_64
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Service ports
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
EXPENSE_SERVICE_PORT=8082

# Mobile app — single entry point through gateway
API_BASE_URL=http://localhost:8080
